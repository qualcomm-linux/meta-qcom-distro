From b9da2ba85acae0567c144ce570378aad1255b05a Mon Sep 17 00:00:00 2001
From: Niranjan Reddy Mekala <nirameka@qti.qualcomm.com>
Date: Mon, 16 Nov 2026 14:45:01 -0800
Subject: [PATCH] virt: allow libvirt to run swtpm for guest vTPMs

Upstream-Status: Submitted [https://github.com/SELinuxProject/refpolicy/pull/1288]

Libvirt uses swtpm to provide TPM functionality for guest VMs.
During vTPM provisioning and runtime, libvirt manages swtpm
log files, TPM state, and communication sockets, and launches
swtpm under the guest security context.

The current virt policy lacks permissions required for these
operations, resulting in AVC denials when using swtpm-backed
guest vTPMs. In particular:

 - virtd_t only has append access to virt_log_t, while libvirt
   may open swtpm log files with O_WRONLY|O_CREAT
 - libvirt relabels TPM state, log files, and sockets during
   VM lifecycle operations
 - swtpm is executed using the guest label via setexeccon()
 - guest domains need to connect to swtpm UNIX sockets
 - swtpm log access may traverse a var_log_t symlink
   (e.g. /var/log -> volatile/log)

 - qemu ramfb uses memfd-backed shared memory which requires
   mapping svirt_tmpfs_t files

Add file contexts for swtpm, allow the required relabel
operations, permit guest socket connections, and enable
execution of swtpm under guest virtualization domains.

Signed-off-by: Niranjan Reddy Mekala <nirameka@qti.qualcomm.com>
---
 policy/modules/services/virt.fc |  3 +++
 policy/modules/services/virt.te | 22 +++++++++++++++++++---
 2 files changed, 22 insertions(+), 3 deletions(-)

diff --git a/policy/modules/services/virt.fc b/policy/modules/services/virt.fc
index ece15deea..bbeef8916 100644
--- a/policy/modules/services/virt.fc
+++ b/policy/modules/services/virt.fc
@@ -35,6 +35,7 @@ HOME_DIR/VirtualMachines/isos(/.*)?	gen_context(system_u:object_r:virt_content_t
 /usr/bin/fence_virtd	--	gen_context(system_u:object_r:virsh_exec_t,s0)
 /usr/bin/libvirt-qmf	--	gen_context(system_u:object_r:virt_qmf_exec_t,s0)
 /usr/bin/libvirtd	--	gen_context(system_u:object_r:virtd_exec_t,s0)
+/usr/bin/swtpm  	--	gen_context(system_u:object_r:swtpm_exec_t,s0)
 /usr/bin/virsh		--	gen_context(system_u:object_r:virsh_exec_t,s0)
 /usr/bin/virtlockd	--	gen_context(system_u:object_r:virtlockd_exec_t,s0)
 /usr/bin/virtlogd	--	gen_context(system_u:object_r:virtlogd_exec_t,s0)
@@ -49,9 +50,11 @@ HOME_DIR/VirtualMachines/isos(/.*)?	gen_context(system_u:object_r:virt_content_t
 /var/lib/libvirt/isos(/.*)?	gen_context(system_u:object_r:virt_content_t,s0)
 /var/lib/libvirt/qemu(/.*)?	gen_context(system_u:object_r:svirt_runtime_t,s0-mls_systemhigh)
 /var/lib/libvirt/lockd(/.*)?	gen_context(system_u:object_r:virtlockd_var_lib_t,s0)
+/var/lib/swtpm-localca(/.*)?    gen_context(system_u:object_r:virt_var_lib_t,s0)
 
 /var/log/log(/.*)?	gen_context(system_u:object_r:virt_log_t,s0)
 /var/log/libvirt(/.*)?	gen_context(system_u:object_r:virt_log_t,s0)
+/var/log/swtpm(/.*)?    gen_context(system_u:object_r:virt_log_t,s0)
 /var/log/vdsm(/.*)?	gen_context(system_u:object_r:virt_log_t,s0)
 
 /var/vdsm(/.*)?		gen_context(system_u:object_r:virt_runtime_t,s0)
diff --git a/policy/modules/services/virt.te b/policy/modules/services/virt.te
index 0f6dc341e..7e6cff62b 100644
--- a/policy/modules/services/virt.te
+++ b/policy/modules/services/virt.te
@@ -120,6 +120,8 @@ type svirt_runtime_t alias svirt_var_run_t;
 files_runtime_file(svirt_runtime_t)
 mls_trusted_object(svirt_runtime_t)
 
+type swtpm_exec_t;
+
 type virt_image_t; # customizable
 virt_image(virt_image_t)
 files_mountpoint(virt_image_t)
@@ -230,7 +232,7 @@ allow virt_domain self:netlink_kobject_uevent_socket create_socket_perms;
 allow virt_domain self:netlink_route_socket r_netlink_socket_perms;
 allow virt_domain self:shm create_shm_perms;
 allow virt_domain self:tcp_socket create_stream_socket_perms;
-allow virt_domain self:unix_stream_socket { accept listen };
+allow virt_domain self:unix_stream_socket { accept connectto listen };
 allow virt_domain self:unix_dgram_socket sendto;
 
 allow virt_domain virtd_t:fd use;
@@ -257,8 +259,16 @@ stream_connect_pattern(virt_domain, virt_runtime_t, virtlockd_run_t, virtlockd_t
 
 dontaudit virt_domain virt_tmpfs_type:file { read write };
 
+# qemu ramfb uses memfd-backed shared memory requiring mmap
+allow virt_domain svirt_tmpfs_t:file map;
+
 append_files_pattern(virt_domain, virt_log_t, virt_log_t)
 
+
+# swtpm accesses vm log files through /var/log which may be a
+# var_log_t labeled symlink (e.g. /var/log -> volatile/log)
+allow virt_domain var_log_t:lnk_file read;
+
 append_files_pattern(virt_domain, virt_var_lib_t, virt_var_lib_t)
 
 kernel_read_system_state(virt_domain)
@@ -295,6 +305,8 @@ dev_rw_kvm(virt_domain)
 dev_rw_qemu(virt_domain)
 dev_rw_vhost(virt_domain)
 
+# libvirt starts swtpm with the guest label (setexeccon)
+domain_entry_file(virt_domain, swtpm_exec_t)
 domain_use_interactive_fds(virt_domain)
 
 files_read_etc_files(virt_domain)
@@ -499,6 +511,7 @@ filetrans_pattern(virtd_t, virt_home_t, virt_content_t, dir, "isos")
 allow virtd_t virtd_keytab_t:file read_file_perms;
 
 allow virtd_t svirt_runtime_t:file relabel_file_perms;
+allow virtd_t svirt_runtime_t:sock_file relabel_sock_file_perms;
 allow virtd_t svirt_runtime_t:dir { mounton relabel_dir_perms };
 manage_dirs_pattern(virtd_t, svirt_runtime_t, svirt_runtime_t)
 manage_files_pattern(virtd_t, svirt_runtime_t, svirt_runtime_t)
@@ -558,15 +571,18 @@ manage_lnk_files_pattern(virtd_t, virt_lock_t, virt_lock_t)
 files_lock_filetrans(virtd_t, virt_lock_t, { dir file lnk_file })
 
 manage_dirs_pattern(virtd_t, virt_log_t, virt_log_t)
-append_files_pattern(virtd_t, virt_log_t, virt_log_t)
+write_files_pattern(virtd_t, virt_log_t, virt_log_t)
 create_files_pattern(virtd_t, virt_log_t, virt_log_t)
 read_files_pattern(virtd_t, virt_log_t, virt_log_t)
 setattr_files_pattern(virtd_t, virt_log_t, virt_log_t)
+relabel_files_pattern(virtd_t, virt_log_t, virt_log_t)
 logging_log_filetrans(virtd_t, virt_log_t, { file dir })
 
 manage_dirs_pattern(virtd_t, virt_var_lib_t, virt_var_lib_t)
 manage_files_pattern(virtd_t, virt_var_lib_t, virt_var_lib_t)
 manage_sock_files_pattern(virtd_t, virt_var_lib_t, virt_var_lib_t)
+relabel_dirs_pattern(virtd_t, virt_var_lib_t, virt_var_lib_t)
+relabel_files_pattern(virtd_t, virt_var_lib_t, virt_var_lib_t)
 files_var_lib_filetrans(virtd_t, virt_var_lib_t, { file dir })
 
 manage_dirs_pattern(virtd_t, virt_runtime_t, virt_runtime_t)
@@ -583,7 +599,7 @@ stream_connect_pattern(virtd_t, { virt_image_type svirt_runtime_t }, { virt_imag
 stream_connect_pattern(virtd_t, virt_runtime_t, virtlockd_run_t, virtlockd_t)
 stream_connect_pattern(virtd_t, virt_runtime_t, virtlogd_run_t, virtlogd_t)
 
-can_exec(virtd_t, virt_tmp_t)
+can_exec(virtd_t, { swtpm_exec_t virt_tmp_t })
 
 kernel_read_system_state(virtd_t)
 kernel_read_network_state(virtd_t)
-- 
