# QuickBoot open-source CAMSS-to-framebuffer preview workload using libcamera
# and GStreamer. Validate camera capture, conversion, and framebuffer output
# without requiring a display server.

set -eu

APP_NAME="quickboot-camera-preview-camss"
CAMERA_WIDTH="${CAMERA_WIDTH:-1920}"
CAMERA_HEIGHT="${CAMERA_HEIGHT:-1080}"
CAMERA_FRAMERATE="${CAMERA_FRAMERATE:-30/1}"
LIBCAMERA_SOFTISP_MODE="${LIBCAMERA_SOFTISP_MODE:-cpu}"
CAMERA_CAPS="video/x-raw,width=${CAMERA_WIDTH},height=${CAMERA_HEIGHT},framerate=${CAMERA_FRAMERATE}"
PREVIEW_SINK_FORMAT="${PREVIEW_SINK_FORMAT:-BGRx}"
PREVIEW_FB_DEVICE="${PREVIEW_FB_DEVICE:-/dev/fb0}"

log() {
    printf '%s: %s\n' "$APP_NAME" "$*"
}

boot_time() {
    awk '{ print $1 }' /proc/uptime
}

CAMERA_START_TIMEOUT="${CAMERA_START_TIMEOUT:-10}"
if ! awk -v limit="$CAMERA_START_TIMEOUT" \
    'BEGIN { exit !(limit ~ /^[0-9]+([.][0-9]+)?$/ && limit > 0) }'; then
    log "CAMERA_START_TIMEOUT must be a positive number of seconds"
    exit 2
fi

START_TIME=$(boot_time)
PIPELINE_PID=

stop_pipeline() {
    trap '' INT TERM
    if [ -n "$PIPELINE_PID" ]; then
        kill -s INT "$PIPELINE_PID" 2>/dev/null || :
        wait "$PIPELINE_PID" 2>/dev/null || :
    fi
    exit "$1"
}

trap 'stop_pipeline 130' INT
trap 'stop_pipeline 143' TERM

startup_remaining() {
    awk -v start="$START_TIME" -v limit="$CAMERA_START_TIMEOUT" \
        '{ remaining = start + limit - $1
           if (remaining <= 0) exit 1
           printf "%.3f", remaining }' /proc/uptime
}

CAMERA_LIST_FILE=$(mktemp)
trap 'rm -f "$CAMERA_LIST_FILE"' EXIT

log "Preparing CAMSS-to-framebuffer preview: caps=${CAMERA_CAPS} timeout=${CAMERA_START_TIMEOUT}s"

status=124
attempt=0
while remaining=$(startup_remaining); do
    if [ ! -c "$PREVIEW_FB_DEVICE" ]; then
        sleep 0.1
        continue
    fi
    # Ask libcamera to enumerate a usable camera; node numbers are unstable.
    timeout --signal=INT --kill-after=2 "$remaining" \
        env "LIBCAMERA_SOFTISP_MODE=${LIBCAMERA_SOFTISP_MODE}" \
        cam --list > "$CAMERA_LIST_FILE" &
    PIPELINE_PID=$!
    if wait "$PIPELINE_PID"; then
        PIPELINE_PID=
        if ! grep -Eq '^[[:space:]]*[0-9]+:' "$CAMERA_LIST_FILE"; then
            sleep 0.1
            continue
        fi
    else
        status=$?
        PIPELINE_PID=
        log "Camera enumeration failed: exit=${status}"
        sleep 0.1
        continue
    fi
    startup_remaining >/dev/null || break
    attempt=$((attempt + 1))
    log "Starting CAMSS-to-framebuffer preview: attempt=${attempt} device=${PREVIEW_FB_DEVICE} format=${PREVIEW_SINK_FORMAT}"
    # Keep a running preview alive; only retry exits inside the startup window.
    env "LIBCAMERA_SOFTISP_MODE=${LIBCAMERA_SOFTISP_MODE}" \
        GST_REGISTRY_UPDATE=no gst-launch-1.0 -e \
        libcamerasrc \
        ! "${CAMERA_CAPS}" \
        ! videoconvert \
        ! "video/x-raw,format=${PREVIEW_SINK_FORMAT}" \
        ! fbdevsink device="${PREVIEW_FB_DEVICE}" &
    PIPELINE_PID=$!
    if wait "$PIPELINE_PID"; then
        PIPELINE_PID=
        exit 0
    else
        status=$?
    fi
    PIPELINE_PID=
    log "Preview attempt ${attempt} failed: exit=${status}"
    sleep 0.1
done

log "Preview failed; startup retry window (${CAMERA_START_TIMEOUT}s) expired: framebuffer=${PREVIEW_FB_DEVICE}"
exit "$status"
