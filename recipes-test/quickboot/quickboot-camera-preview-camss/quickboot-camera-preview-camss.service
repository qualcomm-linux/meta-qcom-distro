# Reference systemd entry point for QuickBoot open-source CAMSS camera preview
# validation through the Linux framebuffer. Disabled by default; enable it
# explicitly from a validation or test flow.

[Unit]
Description=QuickBoot CAMSS Camera-to-Framebuffer Preview Test

[Service]
Type=simple
ExecStart=/usr/bin/quickboot-camera-preview-camss
# Treat an explicit stop as cancellation, not a capture failure.
SuccessExitStatus=130 143
# gst-launch -e handles SIGINT by sending EOS before tearing down the pipeline.
# This releases the libcamera capture resources before the service stops.
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
