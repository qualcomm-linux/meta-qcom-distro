# Reference systemd entry point for display-independent QuickBoot open-source
# CAMSS camera readiness validation. Disabled by default; enable it explicitly
# from a validation or test flow.

[Unit]
Description=QuickBoot CAMSS Camera First-Frame Readiness Test

[Service]
Type=oneshot
ExecStart=/usr/bin/quickboot-camera-readiness-camss
# Treat an explicit stop as cancellation, not a capture failure.
SuccessExitStatus=130 143
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
