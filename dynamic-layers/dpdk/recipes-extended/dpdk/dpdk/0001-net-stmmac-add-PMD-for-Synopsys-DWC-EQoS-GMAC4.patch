diff --git a/drivers/net/stmmac/stmmac_regs.h b/drivers/net/stmmac/stmmac_regs.h
new file mode 100644
index 0000000000..2fac1d9f21
--- /dev/null
+++ b/drivers/net/stmmac/stmmac_regs.h
@@ -0,0 +1,302 @@
+/* SPDX-License-Identifier: BSD-3-Clause
+ * Copyright 2026 Qualcomm Technologies, Inc.
+ */
+
+#ifndef _STMMAC_REGS_H_
+#define _STMMAC_REGS_H_
+
+#include <stdint.h>
+#include <rte_bitops.h>
+#include <rte_common.h>
+#include <rte_io.h>
+
+/*
+ * Register and bitfield definitions for the Synopsys DWC EQoS GMAC4 core
+ * ("stmmac" / "dwmac4" in the Linux driver family). Offsets and bit positions
+ * follow drivers/net/ethernet/stmicro/stmmac/{dwmac4.h, dwmac4_dma.h,
+ * dwmac4_descs.h, descs.h, stmmac_mdio.c, dwmac4_core.c}.
+ */
+
+/*
+ * Per-channel DMA/MTL register stride. The generic dwmac4 layout is used by
+ * default; platforms with has_emac_ge_3 use a 0x1000 stride.
+ */
+struct stmmac_chan_addrs {
+	uint32_t dma_chan_base;
+	uint32_t dma_chan_stride;
+	uint32_t mtl_chan_base;
+	uint32_t mtl_chan_stride;
+};
+
+/* ---------------------------------------------------------------- */
+/* MAC registers                                                     */
+/* ---------------------------------------------------------------- */
+
+#define GMAC_CONFIG			0x00000000
+#define GMAC_PACKET_FILTER		0x00000008
+#define GMAC_HW_FEATURE1		0x00000120
+#define GMAC_MDIO_ADDR			0x00000200
+#define GMAC_MDIO_DATA			0x00000204
+#define GMAC_RXQ_CTRL0			0x000000a0
+#define GMAC_ADDR_HIGH(reg)		(0x300 + (reg) * 8)
+#define GMAC_ADDR_LOW(reg)		(0x304 + (reg) * 8)
+
+/* GMAC_CONFIG bits */
+#define GMAC_CONFIG_IPC			RTE_BIT32(27)
+#define GMAC_CONFIG_ACS			RTE_BIT32(20)
+#define GMAC_CONFIG_TE			RTE_BIT32(1)
+#define GMAC_CONFIG_RE			RTE_BIT32(0)
+
+/* GMAC_PACKET_FILTER bits */
+#define GMAC_PACKET_FILTER_PR		RTE_BIT32(0)
+
+/* GMAC_HW_FEATURE1: RX/TX FIFO size encodings */
+#define GMAC_HWF1_RXFIFOSIZE_MASK	0x1fu		/* [4:0]  */
+#define GMAC_HWF1_TXFIFOSIZE_SHIFT	6		/* [10:6] */
+#define GMAC_HWF1_TXFIFOSIZE_MASK	0x1fu
+
+/* ---------------------------------------------------------------- */
+/* MTL registers                                                     */
+/* ---------------------------------------------------------------- */
+
+#define MTL_CHAN_BASE_ADDR		0x00000d00
+#define MTL_CHAN_BASE_OFFSET		0x40
+#define MTL_RXQ_DMA_MAP0		0x00000c30
+
+static inline uint32_t
+stmmac_mtl_chan_base(const struct stmmac_chan_addrs *addrs, uint32_t x)
+{
+	if (addrs != NULL)
+		return addrs->mtl_chan_base + x * addrs->mtl_chan_stride;
+	return MTL_CHAN_BASE_ADDR + x * MTL_CHAN_BASE_OFFSET;
+}
+
+#define MTL_CHAN_TX_OP_MODE(addrs, x) \
+	(stmmac_mtl_chan_base((addrs), (x)))
+#define MTL_CHAN_RX_OP_MODE(addrs, x) \
+	(stmmac_mtl_chan_base((addrs), (x)) + 0x30)
+
+#define MTL_OP_MODE_TSF			RTE_BIT32(1)
+#define MTL_OP_MODE_TXQEN		RTE_BIT32(3)
+#define MTL_OP_MODE_TXQEN_MASK		(0x3u << 2)
+#define MTL_OP_MODE_RSF			RTE_BIT32(5)
+#define MTL_OP_MODE_TQS_MASK		(0x1ffu << 16)
+#define MTL_OP_MODE_TQS_SHIFT		16
+#define MTL_OP_MODE_RQS_MASK		(0x3ffu << 20)
+#define MTL_OP_MODE_RQS_SHIFT		20
+
+/* ---------------------------------------------------------------- */
+/* DMA registers                                                     */
+/* ---------------------------------------------------------------- */
+
+#define DMA_BUS_MODE			0x00001000
+#define DMA_SYS_BUS_MODE		0x00001004
+#define DMA_AXI_BUS_MODE		0x00001028
+
+#define DMA_BUS_MODE_SFT_RESET		RTE_BIT32(0)
+
+/* DMA_SYS_BUS_MODE bits */
+#define DMA_SYS_BUS_MB			RTE_BIT32(14)
+#define DMA_SYS_BUS_AAL			RTE_BIT32(12)
+#define DMA_SYS_BUS_EAME		RTE_BIT32(11)
+#define DMA_SYS_BUS_FB			RTE_BIT32(0)
+
+/* DMA_AXI_BUS_MODE bits */
+#define DMA_AXI_WR_OSR_LMT		(0xfu << 24)
+#define DMA_AXI_WR_OSR_LMT_SHIFT	24
+#define DMA_AXI_RD_OSR_LMT		(0xfu << 16)
+#define DMA_AXI_RD_OSR_LMT_SHIFT	16
+#define DMA_AXI_BLEN16			RTE_BIT32(3)
+#define DMA_AXI_OSR_MAX			0xf
+
+/* Per-channel DMA registers */
+#define DMA_CHAN_BASE_ADDR		0x00001100
+#define DMA_CHAN_BASE_OFFSET		0x80
+
+static inline uint32_t
+stmmac_dma_chan_base(const struct stmmac_chan_addrs *addrs, uint32_t x)
+{
+	if (addrs != NULL)
+		return addrs->dma_chan_base + x * addrs->dma_chan_stride;
+	return DMA_CHAN_BASE_ADDR + x * DMA_CHAN_BASE_OFFSET;
+}
+
+/*
+ * Offsets relative to a resolved per-channel base (chan_base already holds
+ * mac_base + stmmac_dma_chan_base(addrs, 0)).
+ */
+#define DMA_CHAN_OFF_CONTROL		0x00
+#define DMA_CHAN_OFF_TX_CONTROL		0x04
+#define DMA_CHAN_OFF_RX_CONTROL		0x08
+#define DMA_CHAN_OFF_TX_BASE_ADDR_HI	0x10
+#define DMA_CHAN_OFF_TX_BASE_ADDR	0x14
+#define DMA_CHAN_OFF_RX_BASE_ADDR_HI	0x18
+#define DMA_CHAN_OFF_RX_BASE_ADDR	0x1c
+#define DMA_CHAN_OFF_RX_END_ADDR_HI	0x24
+#define DMA_CHAN_OFF_TX_END_ADDR	0x20
+#define DMA_CHAN_OFF_RX_END_ADDR	0x28
+#define DMA_CHAN_OFF_TX_RING_LEN	0x2c
+#define DMA_CHAN_OFF_RX_RING_LEN	0x30
+#define DMA_CHAN_OFF_CURTXD		0x44
+#define DMA_CHAN_OFF_STATUS		0x60
+
+#define DMA_CHAN_TX_CONTROL_OSP		RTE_BIT32(4)
+
+/* DMA_CHAN_CONTROL / TX / RX control bits */
+#define DMA_CONTROL_PBLX8		RTE_BIT32(16)
+#define DMA_CONTROL_ST			RTE_BIT32(0)
+#define DMA_CONTROL_RPF			RTE_BIT32(31)
+#define DMA_CONTROL_SR			RTE_BIT32(0)
+#define DMA_CONTROL_PBL_SHIFT		16
+#define DMA_CONTROL_PBL_MASK		(0x3fu << DMA_CONTROL_PBL_SHIFT)
+#define DMA_CONTROL_RBSZ_SHIFT		1
+#define DMA_CONTROL_RBSZ_MASK		(0x3fffu << DMA_CONTROL_RBSZ_SHIFT)
+
+/* DMA_CHAN_STATUS bits */
+#define DMA_CHAN_STATUS_TI		RTE_BIT32(0)
+#define DMA_CHAN_STATUS_RI		RTE_BIT32(6)
+#define DMA_CHAN_STATUS_RBU		RTE_BIT32(7)
+
+/*
+ * The Shikra EMAC is not DMA-coherent: CPU writes to descriptors must be
+ * cleaned to the point of coherency before the DMA reads them, and lines must
+ * be invalidated before the CPU reads DMA write-back.
+ */
+#define STMMAC_CACHE_LINE		64
+/* 16-byte descriptors, four per cache line; the ring base is 64-byte aligned */
+#define STMMAC_DESCS_PER_LINE		(STMMAC_CACHE_LINE / 16)
+
+/*
+ * Cache maintenance for a non-coherent DMA (arm64). Clean writes CPU-written
+ * lines back so the DMA reads them; flush also discards CPU copies before the
+ * CPU reads DMA write-back. dsb orders the maintenance before the DMA sees it.
+ */
+static inline void
+stmmac_dcache_clean(const void *addr, size_t len)
+{
+	uintptr_t p = (uintptr_t)addr & ~(uintptr_t)(STMMAC_CACHE_LINE - 1);
+	uintptr_t end = (uintptr_t)addr + len;
+
+	for (; p < end; p += STMMAC_CACHE_LINE)
+		asm volatile("dc cvac, %0" : : "r"(p) : "memory");
+	asm volatile("dsb sy" : : : "memory");
+}
+
+static inline void
+stmmac_dcache_flush(const void *addr, size_t len)
+{
+	uintptr_t p = (uintptr_t)addr & ~(uintptr_t)(STMMAC_CACHE_LINE - 1);
+	uintptr_t end = (uintptr_t)addr + len;
+
+	for (; p < end; p += STMMAC_CACHE_LINE)
+		asm volatile("dc civac, %0" : : "r"(p) : "memory");
+	asm volatile("dsb sy" : : : "memory");
+}
+
+static inline void
+stmmac_dcache_inval_line(const void *addr)
+{
+	asm volatile("dc civac, %0" : : "r"(addr) : "memory");
+	rte_io_rmb();
+}
+
+/* ---------------------------------------------------------------- */
+/* TX descriptor bits                                                */
+/* ---------------------------------------------------------------- */
+
+/* TDES2 (read format) */
+#define TDES2_BUFFER1_SIZE_MASK		0x3fffu
+#define TDES2_INTERRUPT_ON_COMPLETION	RTE_BIT32(31)
+
+/* TDES3 (read format) */
+#define TDES3_PACKET_SIZE_MASK		0x7fffu
+#define TDES3_CHECKSUM_INSERTION_MASK	(0x3u << 16)
+#define TDES3_CHECKSUM_INSERTION_SHIFT	16
+
+/* Insert IP header and pseudo-header checksums */
+#define TX_CIC_FULL			3
+
+/* TDES3 (write-back and common) */
+#define TDES3_ERROR_SUMMARY		RTE_BIT32(15)
+#define TDES3_LAST_DESCRIPTOR		RTE_BIT32(28)
+#define TDES3_FIRST_DESCRIPTOR		RTE_BIT32(29)
+#define TDES3_CONTEXT_TYPE		RTE_BIT32(30)
+#define TDES3_OWN			RTE_BIT32(31)
+
+/* ---------------------------------------------------------------- */
+/* RX descriptor bits                                                */
+/* ---------------------------------------------------------------- */
+
+/* RDES1 (write-back format) */
+#define RDES1_IP_HDR_ERROR		RTE_BIT32(3)
+#define RDES1_IPV4_HEADER		RTE_BIT32(4)
+#define RDES1_IPV6_HEADER		RTE_BIT32(5)
+#define RDES1_IP_CSUM_BYPASSED		RTE_BIT32(6)
+#define RDES1_IP_CSUM_ERROR		RTE_BIT32(7)
+
+/* RDES3 (write-back format) */
+#define RDES3_PACKET_SIZE_MASK		0x7fffu
+#define RDES3_ERROR_SUMMARY		RTE_BIT32(15)
+#define RDES3_OVERFLOW_ERROR		RTE_BIT32(21)
+#define RDES3_CRC_ERROR			RTE_BIT32(24)
+#define RDES3_LAST_DESCRIPTOR		RTE_BIT32(28)
+#define RDES3_FIRST_DESCRIPTOR		RTE_BIT32(29)
+#define RDES3_CONTEXT_DESCRIPTOR	RTE_BIT32(30)
+
+/* RDES3 (read format) */
+#define RDES3_BUFFER1_VALID_ADDR	RTE_BIT32(24)
+#define RDES3_INT_ON_COMPLETION_EN	RTE_BIT32(30)
+#define RDES3_OWN			RTE_BIT32(31)
+
+/* ---------------------------------------------------------------- */
+/* MDIO                                                              */
+/* ---------------------------------------------------------------- */
+
+#define MII_BUSY			RTE_BIT32(0)
+#define MII_DATA_MASK			0xffffu
+
+#define MII_GMAC4_GOC_SHIFT		2
+#define MII_GMAC4_WRITE			(1 << MII_GMAC4_GOC_SHIFT)
+#define MII_GMAC4_READ			(3 << MII_GMAC4_GOC_SHIFT)
+
+#define MII_ADDR_SHIFT			21
+#define MII_ADDR_MASK			(0x1fu << MII_ADDR_SHIFT)
+#define MII_REG_SHIFT			16
+#define MII_REG_MASK			(0x1fu << MII_REG_SHIFT)
+
+/* IEEE 802.3 clause-22 registers */
+#define STMMAC_MII_BMSR			0x01
+#define STMMAC_MII_BMSR_LSTATUS		RTE_BIT32(2)
+
+/*
+ * DP83867 PHY registers (clause-22 direct access).
+ * PHYSTS bits: 15:14 speed (11 = 1000, 10 = 100, 01 = 10 Mb/s),
+ * 13 duplex (1 = full), 10 link (not latched).
+ */
+#define DP83867_PHYSTS			0x11
+#define DP83867_PHYSTS_LINK_BIT		RTE_BIT32(10)
+#define DP83867_PHYSTS_SPEED_MASK	(RTE_BIT32(15) | RTE_BIT32(14))
+#define DP83867_PHYSTS_SPEED_1G		RTE_BIT32(15)
+#define DP83867_PHYSTS_SPEED_100M	RTE_BIT32(14)
+#define DP83867_PHYSTS_DUPLEX_BIT	RTE_BIT32(13)
+
+/* ---------------------------------------------------------------- */
+/* Channel stride presets                                            */
+/* ---------------------------------------------------------------- */
+
+#define STMMAC_CHAN_ADDRS_GENERIC_INIT {		\
+	.dma_chan_base   = DMA_CHAN_BASE_ADDR,		\
+	.dma_chan_stride = DMA_CHAN_BASE_OFFSET,	\
+	.mtl_chan_base   = MTL_CHAN_BASE_ADDR,		\
+	.mtl_chan_stride = MTL_CHAN_BASE_OFFSET,	\
+}
+
+/* has_emac_ge_3 layout (dwmac-qcom-ethqos.c emac_v4_0_0_data) */
+#define STMMAC_CHAN_ADDRS_EMAC_GE3_INIT {		\
+	.dma_chan_base   = 0x8100,			\
+	.dma_chan_stride = 0x1000,			\
+	.mtl_chan_base   = 0x8000,			\
+	.mtl_chan_stride = 0x1000,			\
+}
+
+#endif /* _STMMAC_REGS_H_ */
diff --git a/drivers/net/stmmac/stmmac_rxtx.c b/drivers/net/stmmac/stmmac_rxtx.c
new file mode 100644
index 0000000000..61f7249759
--- /dev/null
+++ b/drivers/net/stmmac/stmmac_rxtx.c
@@ -0,0 +1,416 @@
+/* SPDX-License-Identifier: BSD-3-Clause
+ * Copyright 2026 Qualcomm Technologies, Inc.
+ */
+
+#include <rte_branch_prediction.h>
+#include <rte_common.h>
+#include <rte_cycles.h>
+#include <rte_io.h>
+#include <rte_mbuf.h>
+
+#include "stmmac.h"
+#include "stmmac_regs.h"
+#include "stmmac_logs.h"
+
+#define STMMAC_RX_BUNDLE	32
+#define STMMAC_TX_BUNDLE	32
+
+/* MDIO busy-poll bound, matching stmmac_mdio.c (10000 x 1 us) */
+#define STMMAC_MDIO_TIMEOUT_US		10000
+
+/* Index of the TX descriptor the DMA is working on: everything before it is sent. */
+static inline uint16_t
+stmmac_tx_dma_slot(struct stmmac_tx_queue *txq)
+{
+	uint32_t cur = rte_read32((uint8_t *)txq->chan_base + DMA_CHAN_OFF_CURTXD);
+
+	return (uint16_t)(((cur - (uint32_t)txq->tx_ring_iova) /
+			   sizeof(struct stmmac_desc)) % txq->nb_desc);
+}
+
+/*
+ * MDIO clause-22 read. Uses the GMAC4 opcode and the address/register field
+ * layout from dwmac4_core.c. The CSR clock divider is left at zero.
+ */
+uint16_t
+stmmac_mdio_read(void *mac_base, uint16_t mdio_addr, uint16_t phyreg)
+{
+	void *addr_reg = (uint8_t *)mac_base + GMAC_MDIO_ADDR;
+	void *data_reg = (uint8_t *)mac_base + GMAC_MDIO_DATA;
+	uint32_t value;
+	unsigned int timeout = STMMAC_MDIO_TIMEOUT_US;
+
+	while ((rte_read32(addr_reg) & MII_BUSY) && timeout > 0) {
+		rte_delay_us(1);
+		timeout--;
+	}
+	if (timeout == 0) {
+		STMMAC_PMD_ERR("MDIO busy timeout before read");
+		return 0xffff;
+	}
+
+	value = MII_GMAC4_READ | MII_BUSY;
+	value |= ((uint32_t)mdio_addr << MII_ADDR_SHIFT) & MII_ADDR_MASK;
+	value |= ((uint32_t)phyreg << MII_REG_SHIFT) & MII_REG_MASK;
+
+	rte_write32(value, addr_reg);
+
+	timeout = STMMAC_MDIO_TIMEOUT_US;
+	while ((rte_read32(addr_reg) & MII_BUSY) && timeout > 0) {
+		rte_delay_us(1);
+		timeout--;
+	}
+	if (timeout == 0) {
+		STMMAC_PMD_ERR("MDIO busy timeout after read");
+		return 0xffff;
+	}
+
+	return (uint16_t)(rte_read32(data_reg) & MII_DATA_MASK);
+}
+
+void
+stmmac_mdio_write(void *mac_base, uint16_t mdio_addr, uint16_t phyreg,
+		  uint16_t phydata)
+{
+	void *addr_reg = (uint8_t *)mac_base + GMAC_MDIO_ADDR;
+	void *data_reg = (uint8_t *)mac_base + GMAC_MDIO_DATA;
+	uint32_t value;
+	unsigned int timeout = STMMAC_MDIO_TIMEOUT_US;
+
+	while ((rte_read32(addr_reg) & MII_BUSY) && timeout > 0) {
+		rte_delay_us(1);
+		timeout--;
+	}
+	if (timeout == 0) {
+		STMMAC_PMD_ERR("MDIO busy timeout before write");
+		return;
+	}
+
+	rte_write32(phydata, data_reg);
+
+	value = MII_GMAC4_WRITE | MII_BUSY;
+	value |= ((uint32_t)mdio_addr << MII_ADDR_SHIFT) & MII_ADDR_MASK;
+	value |= ((uint32_t)phyreg << MII_REG_SHIFT) & MII_REG_MASK;
+
+	rte_write32(value, addr_reg);
+
+	timeout = STMMAC_MDIO_TIMEOUT_US;
+	while ((rte_read32(addr_reg) & MII_BUSY) && timeout > 0) {
+		rte_delay_us(1);
+		timeout--;
+	}
+	if (timeout == 0)
+		STMMAC_PMD_ERR("MDIO busy timeout after write");
+}
+
+/*
+ * Refill 'cleaned_cnt' RX descriptors starting at rx_refill. Mbufs are
+ * allocated in bulk, descriptors are written, and each cache line of
+ * descriptors is cleaned once. The DMA doorbell moves to the last descriptor
+ * handed back. Returns the number refilled; a short count means the mbuf pool
+ * ran out, and the remaining slots are retried on the next burst.
+ */
+static uint16_t
+stmmac_refill_rx_ring(struct stmmac_rx_queue *rxq, uint16_t cleaned_cnt)
+{
+	struct rte_mbuf *m[STMMAC_RX_BUNDLE];
+	struct stmmac_desc *grp_start = NULL;
+	uint16_t i = rxq->rx_refill;
+	uint16_t j;
+	uint16_t k = STMMAC_RX_BUNDLE;
+	uint16_t grp_cnt = 0;
+
+	for (j = 0; j < cleaned_cnt; j++) {
+		struct stmmac_desc *desc = &rxq->rx_ring[i];
+		struct rte_mbuf *mb;
+		uint64_t iova;
+
+		/* bulk allocation, sized to the descriptors still to refill */
+		if (k == STMMAC_RX_BUNDLE) {
+			uint16_t m_cnt = RTE_MIN(cleaned_cnt - j, STMMAC_RX_BUNDLE);
+
+			if (rte_pktmbuf_alloc_bulk(rxq->mb_pool, m, m_cnt)) {
+				rxq->rx_nombuf++;
+				break;
+			}
+			k = 0;
+		}
+		mb = m[k++];
+
+		rxq->sw_ring[i] = mb;
+		/* drop stale CPU lines over the buffer the DMA is about to write */
+		stmmac_dcache_flush(rte_pktmbuf_mtod(mb, void *),
+				    rte_pktmbuf_data_room_size(rxq->mb_pool) -
+				    RTE_PKTMBUF_HEADROOM);
+
+		/* full 36-bit buffer address: the mbufs live above 4 GiB */
+		iova = rte_pktmbuf_iova(mb);
+		desc->des[0] = (uint32_t)iova;
+		desc->des[1] = (uint32_t)(iova >> 32);
+		desc->des[2] = 0;
+		rte_io_wmb();
+		desc->des[3] = RDES3_OWN | RDES3_BUFFER1_VALID_ADDR |
+			       RDES3_INT_ON_COMPLETION_EN;
+
+		/* clean the descriptors one cache line at a time */
+		if (grp_cnt == 0)
+			grp_start = desc;
+		grp_cnt++;
+		if (grp_cnt == STMMAC_DESCS_PER_LINE || i == rxq->nb_desc - 1) {
+			stmmac_dcache_clean(grp_start, grp_cnt * sizeof(*desc));
+			grp_cnt = 0;
+		}
+
+		i = (i + 1) % rxq->nb_desc;
+	}
+
+	/* clean the partial group left by the last descriptor */
+	if (grp_cnt)
+		stmmac_dcache_clean(grp_start, grp_cnt * sizeof(struct stmmac_desc));
+
+	rxq->rx_refill = i;
+
+	if (j > 0) {
+		uint16_t last = (i + rxq->nb_desc - 1) % rxq->nb_desc;
+		uint64_t tail_iova = rxq->rx_ring_iova +
+			(uint64_t)last * sizeof(struct stmmac_desc);
+
+		/*
+		 * Clear RBU if the DMA suspended on an unavailable descriptor. This
+		 * is a write, not a status read: a register read stalls the core.
+		 * The DMA only suspends after it has used every slot refilled so
+		 * far, so the burst that refills again is where RBU is cleared.
+		 */
+		rte_write32(DMA_CHAN_STATUS_RBU,
+			    (uint8_t *)rxq->chan_base + DMA_CHAN_OFF_STATUS);
+
+		/*
+		 * The doorbell is the last descriptor handed back. Writing the
+		 * refill index instead would make RXTAIL equal CURRXD, which the
+		 * DMA treats as an empty ring. The 36-bit tail is written HI first.
+		 */
+		rte_write32((uint32_t)(tail_iova >> 32),
+			    (uint8_t *)rxq->chan_base + DMA_CHAN_OFF_RX_END_ADDR_HI);
+		rte_io_wmb();
+		rte_write32((uint32_t)tail_iova,
+			    (uint8_t *)rxq->chan_base + DMA_CHAN_OFF_RX_END_ADDR);
+	}
+
+	return j;
+}
+
+uint16_t
+stmmac_rx_pkt_burst_nc(void *rx_queue, struct rte_mbuf **rx_pkts,
+		       uint16_t nb_pkts)
+{
+	struct stmmac_rx_queue *rxq = rx_queue;
+	uint16_t nb_rx = 0;
+	uint16_t start = rxq->rx_tail;
+	uint16_t tail = start;
+	uint16_t pending;
+
+	while (nb_rx < nb_pkts) {
+		struct stmmac_desc *desc = &rxq->rx_ring[tail];
+		struct rte_mbuf *rxm;
+		uint32_t des3;
+		uint32_t pkt_len;
+
+		/* slot is waiting for a refill (mbuf allocation failed) */
+		if (rxq->sw_ring[tail] == NULL)
+			break;
+
+		/*
+		 * Shikra is not DMA-coherent: invalidate the descriptor line once
+		 * per cache line, at the start of the burst and at each line
+		 * boundary. A stale OWN bit on a later slot only defers that frame
+		 * to the next burst.
+		 */
+		if (tail == start || tail % STMMAC_DESCS_PER_LINE == 0)
+			stmmac_dcache_inval_line(desc);
+		des3 = rte_read32_relaxed(&desc->des[3]);
+
+		if (des3 & RDES3_OWN)
+			break;
+
+		if (des3 & (RDES3_CONTEXT_DESCRIPTOR | RDES3_ERROR_SUMMARY)) {
+			/* not a frame to deliver: free its buffer, refill allocates a new one */
+			if (des3 & RDES3_ERROR_SUMMARY)
+				rxq->rx_errors++;
+			rte_pktmbuf_free(rxq->sw_ring[tail]);
+			rxq->sw_ring[tail] = NULL;
+			tail = (tail + 1) % rxq->nb_desc;
+			continue;
+		}
+
+		rxm = rxq->sw_ring[tail];
+		rxq->sw_ring[tail] = NULL;
+		pkt_len = des3 & RDES3_PACKET_SIZE_MASK;
+
+		/* drop stale CPU lines over the received payload */
+		stmmac_dcache_flush((uint8_t *)rxm->buf_addr + RTE_PKTMBUF_HEADROOM,
+				    pkt_len);
+
+		rxm->data_off = RTE_PKTMBUF_HEADROOM;
+		rxm->pkt_len = pkt_len;
+		rxm->data_len = pkt_len;
+		rxm->port = rxq->port_id;
+		rxm->nb_segs = 1;
+		rxm->next = NULL;
+		rxm->ol_flags = 0;
+
+		if (desc->des[1] & (RDES1_IPV4_HEADER | RDES1_IPV6_HEADER)) {
+			if (desc->des[1] & RDES1_IP_CSUM_ERROR)
+				rxm->ol_flags |= RTE_MBUF_F_RX_IP_CKSUM_BAD;
+			else
+				rxm->ol_flags |= RTE_MBUF_F_RX_IP_CKSUM_GOOD;
+		}
+
+		rx_pkts[nb_rx++] = rxm;
+		rxq->rx_packets++;
+		rxq->rx_bytes += pkt_len;
+
+		tail = (tail + 1) % rxq->nb_desc;
+	}
+
+	rxq->rx_tail = tail;
+
+	/* refill what was consumed, plus any slots a failed allocation left pending */
+	pending = (tail + rxq->nb_desc - rxq->rx_refill) % rxq->nb_desc;
+	if (pending)
+		stmmac_refill_rx_ring(rxq, pending);
+
+	return nb_rx;
+}
+
+/*
+ * Reclaim sent TX frames in bulk, up to the descriptor the DMA is working on.
+ * Everything before that slot has been transmitted.
+ */
+static uint16_t
+stmmac_clean_tx_ring(struct stmmac_tx_queue *txq)
+{
+	struct rte_mbuf *m[STMMAC_TX_BUNDLE];
+	uint16_t hwci = stmmac_tx_dma_slot(txq);
+	uint16_t i = txq->tx_free;
+	uint16_t n = 0;
+	uint16_t total = 0;
+
+	while (i != hwci && txq->sw_ring[i] != NULL) {
+		if (i == txq->tx_free || i % STMMAC_DESCS_PER_LINE == 0)
+			stmmac_dcache_inval_line(&txq->tx_ring[i]);
+		if (rte_read32_relaxed(&txq->tx_ring[i].des[3]) & TDES3_ERROR_SUMMARY)
+			txq->tx_errors++;
+
+		m[n++] = txq->sw_ring[i];
+		txq->sw_ring[i] = NULL;
+		if (n == STMMAC_TX_BUNDLE) {
+			rte_pktmbuf_free_bulk(m, n);
+			total += n;
+			n = 0;
+		}
+		i = (i + 1) % txq->nb_desc;
+	}
+
+	if (n) {
+		rte_pktmbuf_free_bulk(m, n);
+		total += n;
+	}
+	txq->tx_free = i;
+	return total;
+}
+
+/* Clean the descriptor lines that hold 'cnt' slots from 'first', once, before the doorbell */
+static void
+stmmac_tx_clean_range(struct stmmac_tx_queue *txq, uint16_t first, uint16_t cnt)
+{
+	uint16_t s = first - first % STMMAC_DESCS_PER_LINE;
+	uint16_t left = cnt + (first - s);
+
+	left = (left + STMMAC_DESCS_PER_LINE - 1) / STMMAC_DESCS_PER_LINE *
+		STMMAC_DESCS_PER_LINE;
+	if (left > txq->nb_desc)
+		left = txq->nb_desc;
+
+	while (left) {
+		uint16_t run = RTE_MIN((uint16_t)(txq->nb_desc - s), left);
+
+		stmmac_dcache_clean(&txq->tx_ring[s], run * sizeof(struct stmmac_desc));
+		s = (s + run) % txq->nb_desc;
+		left -= run;
+	}
+}
+
+uint16_t
+stmmac_tx_pkt_burst_nc(void *tx_queue, struct rte_mbuf **tx_pkts,
+		       uint16_t nb_pkts)
+{
+	struct stmmac_tx_queue *txq = tx_queue;
+	uint16_t nb_tx = 0;
+	uint16_t first = txq->tx_tail;
+	uint16_t tail = first;
+
+	stmmac_clean_tx_ring(txq);
+
+	/* drop the CPU copy of the first line before filling into it */
+	stmmac_dcache_inval_line(&txq->tx_ring[first - first % STMMAC_DESCS_PER_LINE]);
+
+	while (nb_tx < nb_pkts) {
+		struct stmmac_desc *desc = &txq->tx_ring[tail];
+		struct rte_mbuf *txm = tx_pkts[nb_tx];
+		uint32_t tdes3;
+		uint64_t iova;
+
+		if (unlikely(txm->nb_segs != 1)) {
+			STMMAC_PMD_ERR("multi-segment mbuf not supported");
+			break;
+		}
+
+		/* ring full: this slot still holds a frame the DMA has not finished */
+		if (txq->sw_ring[tail] != NULL) {
+			txq->tx_ring_full++;
+			break;
+		}
+
+		/* entering a new line: drop the CPU copy before writing into it */
+		if (tail != first && tail % STMMAC_DESCS_PER_LINE == 0)
+			stmmac_dcache_inval_line(desc);
+
+		/* the CPU-written payload must reach memory before the DMA reads it */
+		stmmac_dcache_clean(rte_pktmbuf_mtod(txm, void *),
+				    rte_pktmbuf_data_len(txm));
+
+		iova = rte_pktmbuf_iova(txm);
+		desc->des[0] = (uint32_t)iova;
+		desc->des[1] = (uint32_t)(iova >> 32);
+		desc->des[2] = rte_pktmbuf_data_len(txm) & TDES2_BUFFER1_SIZE_MASK;
+
+		tdes3 = rte_pktmbuf_pkt_len(txm) & TDES3_PACKET_SIZE_MASK;
+		tdes3 |= TDES3_FIRST_DESCRIPTOR | TDES3_LAST_DESCRIPTOR;
+		if (txm->ol_flags & (RTE_MBUF_F_TX_IP_CKSUM | RTE_MBUF_F_TX_L4_MASK))
+			tdes3 |= (TX_CIC_FULL << TDES3_CHECKSUM_INSERTION_SHIFT);
+
+		txq->sw_ring[tail] = txm;
+
+		rte_io_wmb();
+		desc->des[3] = tdes3 | TDES3_OWN;
+
+		txq->tx_packets++;
+		txq->tx_bytes += rte_pktmbuf_pkt_len(txm);
+
+		tail = (tail + 1) % txq->nb_desc;
+		nb_tx++;
+	}
+
+	if (nb_tx > 0) {
+		uint64_t tail_iova = txq->tx_ring_iova +
+			(uint64_t)tail * sizeof(struct stmmac_desc);
+
+		/* the written descriptor lines are cleaned once, then the doorbell moves */
+		stmmac_tx_clean_range(txq, first, nb_tx);
+		txq->tx_tail = tail;
+		rte_write32((uint32_t)tail_iova,
+			    (uint8_t *)txq->chan_base + DMA_CHAN_OFF_TX_END_ADDR);
+	}
+
+	return nb_tx;
+}
