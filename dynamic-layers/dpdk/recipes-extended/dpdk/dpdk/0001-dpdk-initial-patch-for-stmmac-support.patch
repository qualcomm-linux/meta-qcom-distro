diff --git a/drivers/net/stmmac/stmmac_regs.h b/drivers/net/stmmac/stmmac_regs.h
new file mode 100644
index 0000000000..cb2f94cdf4
--- /dev/null
+++ b/drivers/net/stmmac/stmmac_regs.h
@@ -0,0 +1,352 @@
+/* SPDX-License-Identifier: BSD-3-Clause
+ * Copyright 2026 Qualcomm Technologies, Inc.
+ */
+
+#ifndef _STMMAC_REGS_H_
+#define _STMMAC_REGS_H_
+
+#include <stdint.h>
+#include <rte_bitops.h>
+
+/*
+ * Register/bitfield definitions for the Synopsys DWC EQoS GMAC4 core
+ * ("stmmac" / "dwmac4" in the Linux kernel driver family).
+ *
+ * Every macro below is cited against the kernel source it was taken
+ * from, at:
+ *   drivers/net/ethernet/stmicro/stmmac/{dwmac4.h,dwmac4_dma.h,
+ *                                         dwmac4_descs.h,descs.h,
+ *                                         stmmac_mdio.c,dwmac4_core.c}
+ *
+ * Phase 1 scope: single DMA channel (channel 0), generic dwmac4
+ * register stride only. The RGMII/SDCC DLL bring-up performed by
+ * dwmac-qcom-ethqos.c (PoR tables, ethqos_configure_rgmii(), etc.)
+ * is NOT implemented here -- it is SoC-variant-specific and out of
+ * scope for Phase 1. No RGMII/SDC4 register is defined in this file.
+ */
+
+/*
+ * On real Qualcomm SoCs with has_emac_ge_3=true (e.g. emac_v4_0_0_data
+ * in dwmac-qcom-ethqos.c), the DMA/MTL per-channel stride is 0x1000
+ * instead of the generic 0x80/0x40. This override is experimental in
+ * Phase 1 (untested against silicon) and must be opted into via the
+ * "has_emac_ge_3" devarg -- the compiled-in default below is the
+ * generic dwmac4 stride.
+ */
+struct stmmac_chan_addrs {
+	uint32_t dma_chan_base;
+	uint32_t dma_chan_stride;
+	uint32_t mtl_chan_base;
+	uint32_t mtl_chan_stride;
+};
+
+/* ---------------------------------------------------------------- */
+/* MAC registers (dwmac4.h)                                          */
+/* ---------------------------------------------------------------- */
+
+#define GMAC_CONFIG			0x00000000	/* dwmac4.h:16 */
+#define GMAC_PACKET_FILTER		0x00000008	/* dwmac4.h:18 */
+#define GMAC_MDIO_ADDR			0x00000200	/* dwmac4.h:43 */
+#define GMAC_MDIO_DATA			0x00000204	/* dwmac4.h:44 */
+#define GMAC_ADDR_HIGH(reg)		(0x300 + (reg) * 8)	/* dwmac4.h:48 */
+#define GMAC_ADDR_LOW(reg)		(0x304 + (reg) * 8)	/* dwmac4.h:49 */
+
+/* GMAC_CONFIG bits (dwmac4.h:210-229) */
+#define GMAC_CONFIG_IPC			RTE_BIT32(27)	/* dwmac4.h:214 */
+#define GMAC_CONFIG_ACS			RTE_BIT32(20)	/* dwmac4.h:218 */
+#define GMAC_CONFIG_TE			RTE_BIT32(1)	/* dwmac4.h:228 */
+#define GMAC_CONFIG_RE			RTE_BIT32(0)	/* dwmac4.h:229 */
+
+/* GMAC_PACKET_FILTER bits (dwmac4.h:75) */
+#define GMAC_PACKET_FILTER_PR		RTE_BIT32(0)	/* dwmac4.h:75 */
+
+/* ---------------------------------------------------------------- */
+/* MTL registers (dwmac4.h)                                          */
+/* ---------------------------------------------------------------- */
+
+#define MTL_CHAN_BASE_ADDR		0x00000d00	/* dwmac4.h:343 */
+#define MTL_CHAN_BASE_OFFSET		0x40		/* dwmac4.h:344 */
+
+/* mirrors mtl_chanx_base_addr(), dwmac4.h:346-357 -- generic stride
+ * only (no dwmac4_addrs override); the has_emac_ge_3 0x1000 stride
+ * used by real Qualcomm SoCs (emac_v4_0_0_data) is not the Phase 1
+ * default, see struct stmmac_chan_addrs below.
+ */
+static inline uint32_t
+stmmac_mtl_chan_base(const struct stmmac_chan_addrs *addrs, uint32_t x)
+{
+	if (addrs != NULL)
+		return addrs->mtl_chan_base + x * addrs->mtl_chan_stride;
+	return MTL_CHAN_BASE_ADDR + x * MTL_CHAN_BASE_OFFSET;
+}
+
+#define MTL_CHAN_TX_OP_MODE(addrs, x) \
+	(stmmac_mtl_chan_base((addrs), (x)))			/* dwmac4.h:359 */
+#define MTL_CHAN_RX_OP_MODE(addrs, x) \
+	(stmmac_mtl_chan_base((addrs), (x)) + 0x30)		/* dwmac4.h:362 */
+
+#define MTL_OP_MODE_TSF			RTE_BIT32(1)	/* dwmac4.h TX store-forward */
+#define MTL_OP_MODE_TXQEN_MASK		(0x3 << 2)	/* GENMASK(3,2), dwmac4.h */
+#define MTL_OP_MODE_TXQEN		RTE_BIT32(3)	/* dwmac4.h */
+#define MTL_OP_MODE_RSF			RTE_BIT32(5)	/* dwmac4.h RX store-forward */
+#define MTL_OP_MODE_TQS_MASK		(0x1ffu << 16)	/* GENMASK(24,16), dwmac4.h */
+#define MTL_OP_MODE_TQS_SHIFT		16
+#define MTL_OP_MODE_RQS_MASK		(0x3ffu << 20)	/* GENMASK(29,20), dwmac4.h */
+#define MTL_OP_MODE_RQS_SHIFT		20
+
+/* ---------------------------------------------------------------- */
+/* DMA registers (dwmac4_dma.h)                                      */
+/* ---------------------------------------------------------------- */
+
+#define DMA_BUS_MODE			0x00001000	/* dwmac4_dma.h:18 */
+#define DMA_SYS_BUS_MODE		0x00001004	/* dwmac4_dma.h:19 */
+#define DMA_AXI_BUS_MODE		0x00001028	/* dwmac4_dma.h:24 */
+
+#define DMA_BUS_MODE_SFT_RESET		RTE_BIT32(0)	/* dwmac4_dma.h:32 */
+
+/* DMA_SYS_BUS_MODE bits (dwmac4_dma.h:70-81) */
+#define DMA_SYS_BUS_MB			RTE_BIT32(14)	/* dwmac4_dma.h:70 */
+#define DMA_SYS_BUS_AAL			RTE_BIT32(12)	/* dwmac4_dma.h:72 */
+#define DMA_SYS_BUS_EAME		RTE_BIT32(11)	/* dwmac4_dma.h:73 */
+#define DMA_SYS_BUS_FB			RTE_BIT32(0)	/* dwmac4_dma.h:81 */
+
+/* DMA_AXI_BUS_MODE bits (dwmac4_dma.h:59-80) */
+#define DMA_AXI_WR_OSR_LMT		(0xfu << 24)	/* GENMASK(27,24), dwmac4_dma.h:61 */
+#define DMA_AXI_WR_OSR_LMT_SHIFT	24
+#define DMA_AXI_RD_OSR_LMT		(0xfu << 16)	/* GENMASK(19,16), dwmac4_dma.h:63 */
+#define DMA_AXI_RD_OSR_LMT_SHIFT	16
+#define DMA_AXI_BLEN16			RTE_BIT32(3)	/* dwmac4_dma.h:78 */
+#define DMA_AXI_OSR_MAX			0xf		/* dwmac4_dma.h:66 */
+
+/* Per-channel DMA registers: base 0x1100 + x*0x80 (dwmac4_dma.h:96-134) */
+#define DMA_CHAN_BASE_ADDR		0x00001100	/* dwmac4_dma.h:96 */
+#define DMA_CHAN_BASE_OFFSET		0x80		/* dwmac4_dma.h:97 */
+
+/* mirrors dma_chanx_base_addr(), dwmac4_dma.h:99-110 -- generic
+ * stride only, see stmmac_chan_addrs comment above.
+ */
+static inline uint32_t
+stmmac_dma_chan_base(const struct stmmac_chan_addrs *addrs, uint32_t x)
+{
+	if (addrs != NULL)
+		return addrs->dma_chan_base + x * addrs->dma_chan_stride;
+	return DMA_CHAN_BASE_ADDR + x * DMA_CHAN_BASE_OFFSET;
+}
+
+#define DMA_CHAN_CONTROL(addrs, x) \
+	(stmmac_dma_chan_base((addrs), (x)))			/* dwmac4_dma.h:114 */
+#define DMA_CHAN_TX_CONTROL(addrs, x) \
+	(stmmac_dma_chan_base((addrs), (x)) + 0x4)		/* dwmac4_dma.h:115 */
+#define DMA_CHAN_RX_CONTROL(addrs, x) \
+	(stmmac_dma_chan_base((addrs), (x)) + 0x8)		/* dwmac4_dma.h:116 */
+#define DMA_CHAN_TX_BASE_ADDR_HI(addrs, x) \
+	(stmmac_dma_chan_base((addrs), (x)) + 0x10)		/* dwmac4_dma.h:117 */
+#define DMA_CHAN_TX_BASE_ADDR(addrs, x) \
+	(stmmac_dma_chan_base((addrs), (x)) + 0x14)		/* dwmac4_dma.h:118 */
+#define DMA_CHAN_RX_BASE_ADDR_HI(addrs, x) \
+	(stmmac_dma_chan_base((addrs), (x)) + 0x18)		/* dwmac4_dma.h:119 */
+#define DMA_CHAN_RX_BASE_ADDR(addrs, x) \
+	(stmmac_dma_chan_base((addrs), (x)) + 0x1c)		/* dwmac4_dma.h:120 */
+#define DMA_CHAN_TX_END_ADDR(addrs, x) \
+	(stmmac_dma_chan_base((addrs), (x)) + 0x20)		/* dwmac4_dma.h:121 */
+#define DMA_CHAN_RX_END_ADDR(addrs, x) \
+	(stmmac_dma_chan_base((addrs), (x)) + 0x28)		/* dwmac4_dma.h:122 */
+#define DMA_CHAN_TX_RING_LEN(addrs, x) \
+	(stmmac_dma_chan_base((addrs), (x)) + 0x2c)		/* dwmac4_dma.h:123 */
+#define DMA_CHAN_RX_RING_LEN(addrs, x) \
+	(stmmac_dma_chan_base((addrs), (x)) + 0x30)		/* dwmac4_dma.h:124 */
+#define DMA_CHAN_INTR_ENA(addrs, x) \
+	(stmmac_dma_chan_base((addrs), (x)) + 0x34)		/* dwmac4_dma.h:125 */
+#define DMA_CHAN_STATUS(addrs, x) \
+	(stmmac_dma_chan_base((addrs), (x)) + 0x60)		/* dwmac4_dma.h:134 */
+
+/*
+ * Relative (base-independent) intra-channel offsets. The absolute
+ * DMA_CHAN_*(addrs, x) macros above already fold in the resolved
+ * per-channel base (dma_chan_base + x*dma_chan_stride). Callers that
+ * cache an already-resolved base pointer (see stmmac_tx_queue/
+ * stmmac_rx_queue chan_base in stmmac.h, which is
+ * mac_base + stmmac_dma_chan_base(addrs, 0)) must add these relative
+ * offsets instead of the absolute macros, or the channel base gets
+ * added twice.
+ */
+#define DMA_CHAN_OFF_TX_BASE_ADDR	0x14	/* dwmac4_dma.h:118 */
+#define DMA_CHAN_OFF_RX_BASE_ADDR	0x1c	/* dwmac4_dma.h:120 */
+#define DMA_CHAN_OFF_TX_END_ADDR	0x20	/* dwmac4_dma.h:121 */
+#define DMA_CHAN_OFF_RX_END_ADDR	0x28	/* dwmac4_dma.h:122 */
+#define DMA_CHAN_OFF_TX_RING_LEN	0x2c	/* dwmac4_dma.h:123 */
+#define DMA_CHAN_OFF_RX_RING_LEN	0x30	/* dwmac4_dma.h:124 */
+
+/* DMA_CHAN_TX_CONTROL bit (dwmac4_dma.h:144) */
+#define DMA_CONTROL_ST			RTE_BIT32(0)
+/* DMA_CHAN_RX_CONTROL bits (dwmac4_dma.h:147-148) */
+#define DMA_CONTROL_RPF		RTE_BIT32(31)
+#define DMA_CONTROL_SR			RTE_BIT32(0)
+
+/* DMA_CHAN_STATUS bits used for polling completion without IRQ
+ * (dwmac4_dma.h:166,169); write-1-to-clear per stmmac_main.c usage.
+ */
+#define DMA_CHAN_STATUS_RI		RTE_BIT32(6)	/* dwmac4_dma.h:166 */
+#define DMA_CHAN_STATUS_RBU		RTE_BIT32(7)	/* dwmac4_dma.h:165 */
+#define DMA_CHAN_STATUS_TI		RTE_BIT32(0)	/* dwmac4_dma.h:169 */
+#define DMA_CHAN_OFF_STATUS		0x60	/* dwmac4_dma.h:134 */
+
+/*
+ * Shikra EMAC is not DMA-coherent (no dma-coherent in DT): CPU writes to
+ * descriptors must be cleaned to PoC before the DMA reads them, and lines
+ * must be invalidated before the CPU reads DMA write-back.
+ */
+#define STMMAC_CACHE_LINE		64
+/* 16-byte descriptors per cache line; ring base is 64B-aligned (memzone) */
+#define STMMAC_DESCS_PER_LINE		(STMMAC_CACHE_LINE / 16)
+
+static inline void
+stmmac_dcache_clean(const void *addr, size_t len)
+{
+	uintptr_t p = (uintptr_t)addr & ~(uintptr_t)(STMMAC_CACHE_LINE - 1);
+	uintptr_t end = (uintptr_t)addr + len;
+
+	for (; p < end; p += STMMAC_CACHE_LINE)
+		asm volatile("dc cvac, %0" : : "r"(p) : "memory");
+	asm volatile("dsb sy" : : : "memory");
+}
+
+static inline void
+stmmac_dcache_flush(const void *addr, size_t len)
+{
+	uintptr_t p = (uintptr_t)addr & ~(uintptr_t)(STMMAC_CACHE_LINE - 1);
+	uintptr_t end = (uintptr_t)addr + len;
+
+	for (; p < end; p += STMMAC_CACHE_LINE)
+		asm volatile("dc civac, %0" : : "r"(p) : "memory");
+	asm volatile("dsb sy" : : : "memory");
+}
+
+/* ---------------------------------------------------------------- */
+/* TX descriptor bits (dwmac4_descs.h, descs.h)                      */
+/* ---------------------------------------------------------------- */
+
+/* TDES2 (read format), dwmac4_descs.h:19-30 */
+#define TDES2_BUFFER1_SIZE_MASK		0x3fffu		/* GENMASK(13,0) */
+#define TDES2_INTERRUPT_ON_COMPLETION	RTE_BIT32(31)
+
+/* TDES3 (read format), dwmac4_descs.h:33-39 */
+#define TDES3_PACKET_SIZE_MASK		0x7fffu		/* GENMASK(14,0) */
+#define TDES3_CHECKSUM_INSERTION_MASK	(0x3u << 16)	/* GENMASK(17,16) */
+#define TDES3_CHECKSUM_INSERTION_SHIFT	16
+
+/* TX_CIC_FULL: include IP header + pseudoheader checksum insertion,
+ * descs.h:184.
+ */
+#define TX_CIC_FULL			3
+
+/* TDES3 (write-back/common), dwmac4_descs.h:60-84 */
+#define TDES3_ERROR_SUMMARY		RTE_BIT32(15)	/* dwmac4_descs.h:60 */
+#define TDES3_LAST_DESCRIPTOR		RTE_BIT32(28)	/* dwmac4_descs.h:70 */
+#define TDES3_FIRST_DESCRIPTOR		RTE_BIT32(29)	/* dwmac4_descs.h:72 */
+#define TDES3_CONTEXT_TYPE		RTE_BIT32(30)	/* dwmac4_descs.h:73 */
+#define TDES3_OWN			RTE_BIT32(31)	/* dwmac4_descs.h:84 */
+
+/* ---------------------------------------------------------------- */
+/* RX descriptor bits (dwmac4_descs.h)                                */
+/* ---------------------------------------------------------------- */
+
+/* RDES1 (write-back format), dwmac4_descs.h:94-98 */
+#define RDES1_IP_HDR_ERROR		RTE_BIT32(3)
+#define RDES1_IPV4_HEADER		RTE_BIT32(4)
+#define RDES1_IPV6_HEADER		RTE_BIT32(5)
+#define RDES1_IP_CSUM_BYPASSED		RTE_BIT32(6)
+#define RDES1_IP_CSUM_ERROR		RTE_BIT32(7)
+
+/* RDES3 (write-back format), dwmac4_descs.h:122-136 */
+#define RDES3_PACKET_SIZE_MASK		0x7fffu		/* GENMASK(14,0) */
+#define RDES3_ERROR_SUMMARY		RTE_BIT32(15)
+#define RDES3_OVERFLOW_ERROR		RTE_BIT32(21)
+#define RDES3_CRC_ERROR			RTE_BIT32(24)
+#define RDES3_LAST_DESCRIPTOR		RTE_BIT32(28)
+#define RDES3_FIRST_DESCRIPTOR		RTE_BIT32(29)
+#define RDES3_CONTEXT_DESCRIPTOR	RTE_BIT32(30)
+
+/* RDES3 (read format), dwmac4_descs.h:140-142 */
+#define RDES3_BUFFER1_VALID_ADDR	RTE_BIT32(24)
+#define RDES3_INT_ON_COMPLETION_EN	RTE_BIT32(30)
+
+/* RDES3_OWN shared read/write-back, dwmac4_descs.h:145 */
+#define RDES3_OWN			RTE_BIT32(31)
+
+/* ---------------------------------------------------------------- */
+/* MDIO (stmmac_mdio.c:26-34, field layout dwmac4_core.c:1368-1375)   */
+/* ---------------------------------------------------------------- */
+
+#define MII_BUSY			RTE_BIT32(0)	/* stmmac_mdio.c:26 */
+#define MII_DATA_MASK			0xffffu		/* GENMASK(15,0), stmmac_mdio.c:28 */
+
+#define MII_GMAC4_GOC_SHIFT		2		/* stmmac_mdio.c:31 */
+#define MII_GMAC4_WRITE			(1 << MII_GMAC4_GOC_SHIFT)	/* stmmac_mdio.c:33 */
+#define MII_GMAC4_READ			(3 << MII_GMAC4_GOC_SHIFT)	/* stmmac_mdio.c:34 */
+
+/* GMAC4 MDIO address-register field layout, dwmac4_core.c:1368-1375 */
+#define MII_ADDR_SHIFT			21
+#define MII_ADDR_MASK			(0x1fu << MII_ADDR_SHIFT)	/* GENMASK(25,21) */
+#define MII_REG_SHIFT			16
+#define MII_REG_MASK			(0x1fu << MII_REG_SHIFT)	/* GENMASK(20,16) */
+#define MII_CLK_CSR_SHIFT		8
+#define MII_CLK_CSR_MASK		(0xfu << MII_CLK_CSR_SHIFT)	/* GENMASK(11,8) */
+
+/* IEEE 802.3 clause-22 standard MDIO registers, used for generic
+ * link-up polling (no vendor-specific PHY register access here).
+ */
+#define STMMAC_MII_BMCR			0x00
+#define STMMAC_MII_BMSR			0x01
+#define STMMAC_MII_BMSR_LSTATUS		RTE_BIT32(2)
+
+/*
+ * DP83867 vendor registers accessed via clause-22 MMD indirect
+ * (REGCR/ADDAR) already declared in stmmac_ethdev.c; the PHYSTS
+ * direct register (0x11) is a standard clause-22 address and can
+ * be read without MMD indirection.
+ *
+ * PHYSTS bit definitions (DP83867 datasheet Table 8):
+ *   bit 15:14  speed indication  11=1000, 10=100, 01=10 Mb/s
+ *   bit 13     duplex            1=full, 0=half
+ *   bit 2      link status       1=link up (NOT latched -- real-time)
+ */
+#define MD_DP83867_PHYSTS		0x11
+#define MD_DP83867_PHYSTS_LINK_BIT	RTE_BIT32(10)	/* dp83867.c DP83867_PHYSTS_LINK */
+#define MD_DP83867_PHYSTS_SPEED_MASK	(RTE_BIT32(15) | RTE_BIT32(14))
+#define MD_DP83867_PHYSTS_SPEED_1G	RTE_BIT32(15)	/* dp83867.c DP83867_PHYSTS_1000 */
+#define MD_DP83867_PHYSTS_SPEED_100M	RTE_BIT32(14)	/* dp83867.c DP83867_PHYSTS_100 */
+#define MD_DP83867_PHYSTS_DUPLEX_BIT	RTE_BIT32(13)
+
+/*
+ * DMA_CHAN_RX_END_ADDR_HI: upper 32 bits of the 36-bit RX tail
+ * doorbell.  Relative offset within the resolved per-channel base
+ * (chan_base already = mac_base + dma_chan_base(addrs,0)).
+ * dwmac4_dma.h:123 names this DMA_CHAN_RX_END_ADDR_HI at +0x24.
+ */
+#define DMA_CHAN_OFF_RX_END_ADDR_HI	0x24
+
+/* ---------------------------------------------------------------- */
+/* Per-channel DMA/MTL register stride override initializers         */
+/* ---------------------------------------------------------------- */
+
+/* Generic default, matches dwmac4.h/dwmac4_dma.h fallback values. */
+#define STMMAC_CHAN_ADDRS_GENERIC_INIT {		\
+	.dma_chan_base   = DMA_CHAN_BASE_ADDR,		\
+	.dma_chan_stride = DMA_CHAN_BASE_OFFSET,	\
+	.mtl_chan_base   = MTL_CHAN_BASE_ADDR,		\
+	.mtl_chan_stride = MTL_CHAN_BASE_OFFSET,	\
+}
+
+/* has_emac_ge_3 override, matches dwmac-qcom-ethqos.c emac_v4_0_0_data
+ * (dma_chan=0x8100/offset=0x1000, mtl_chan=0x8000/offset=0x1000).
+ * Experimental -- opt in via "has_emac_ge_3=1" devarg.
+ */
+#define STMMAC_CHAN_ADDRS_EMAC_GE3_INIT {		\
+	.dma_chan_base   = 0x8100,			\
+	.dma_chan_stride = 0x1000,			\
+	.mtl_chan_base   = 0x8000,			\
+	.mtl_chan_stride = 0x1000,			\
+}
+
+#endif /* _STMMAC_REGS_H_ */
diff --git a/drivers/net/stmmac/stmmac_rxtx.c b/drivers/net/stmmac/stmmac_rxtx.c
new file mode 100644
index 0000000000..b5a98d3352
--- /dev/null
+++ b/drivers/net/stmmac/stmmac_rxtx.c
@@ -0,0 +1,449 @@
+/* SPDX-License-Identifier: BSD-3-Clause
+ * Copyright 2026 Qualcomm Technologies, Inc.
+ */
+
+#include <inttypes.h>
+#include <stdio.h>
+#include <string.h>
+
+#include <rte_common.h>
+#include <rte_branch_prediction.h>
+#include <rte_cycles.h>
+#include <rte_io.h>
+#include <rte_mbuf.h>
+
+#include "stmmac.h"
+#include "stmmac_regs.h"
+#include "stmmac_logs.h"
+
+/* MDIO busy-poll timeout, matches stmmac_mdio.c's readl_poll_timeout
+ * bound (10000 x 10us iterations there); Phase 1 uses a simple
+ * bounded spin since there is no interrupt path.
+ */
+#define STMMAC_MDIO_TIMEOUT_US		10000
+
+/*
+ * MDIO C22 read/write -- direct port of stmmac_mdio_read_c22()/
+ * stmmac_mdio_write_c22() (stmmac_mdio.c), using the GMAC4 opcode
+ * bits (MII_GMAC4_READ/WRITE) and the address/reg/clk_csr field
+ * layout from dwmac4_core.c:1368-1375. clk_csr is left at 0 (Phase 1
+ * does not compute a CSR clock divider from bus clock rate).
+ */
+uint16_t
+stmmac_mdio_read(void *mac_base, uint16_t mdio_addr, uint16_t phyreg)
+{
+	void *addr_reg = (uint8_t *)mac_base + GMAC_MDIO_ADDR;
+	void *data_reg = (uint8_t *)mac_base + GMAC_MDIO_DATA;
+	uint32_t value;
+	unsigned int timeout = STMMAC_MDIO_TIMEOUT_US;
+
+	while ((rte_read32(addr_reg) & MII_BUSY) && timeout > 0) {
+		rte_delay_us(1);
+		timeout--;
+	}
+	if (timeout == 0) {
+		STMMAC_PMD_ERR("MDIO busy timeout before read");
+		return 0xffff;
+	}
+
+	value = MII_GMAC4_READ | MII_BUSY;
+	value |= ((uint32_t)mdio_addr << MII_ADDR_SHIFT) & MII_ADDR_MASK;
+	value |= ((uint32_t)phyreg << MII_REG_SHIFT) & MII_REG_MASK;
+
+	rte_write32(value, addr_reg);
+
+	timeout = STMMAC_MDIO_TIMEOUT_US;
+	while ((rte_read32(addr_reg) & MII_BUSY) && timeout > 0) {
+		rte_delay_us(1);
+		timeout--;
+	}
+	if (timeout == 0) {
+		STMMAC_PMD_ERR("MDIO busy timeout after read");
+		return 0xffff;
+	}
+
+	return (uint16_t)(rte_read32(data_reg) & MII_DATA_MASK);
+}
+
+void
+stmmac_mdio_write(void *mac_base, uint16_t mdio_addr, uint16_t phyreg,
+		   uint16_t phydata)
+{
+	void *addr_reg = (uint8_t *)mac_base + GMAC_MDIO_ADDR;
+	void *data_reg = (uint8_t *)mac_base + GMAC_MDIO_DATA;
+	uint32_t value;
+	unsigned int timeout = STMMAC_MDIO_TIMEOUT_US;
+
+	while ((rte_read32(addr_reg) & MII_BUSY) && timeout > 0) {
+		rte_delay_us(1);
+		timeout--;
+	}
+	if (timeout == 0) {
+		STMMAC_PMD_ERR("MDIO busy timeout before write");
+		return;
+	}
+
+	rte_write32(phydata, data_reg);
+
+	value = MII_GMAC4_WRITE | MII_BUSY;
+	value |= ((uint32_t)mdio_addr << MII_ADDR_SHIFT) & MII_ADDR_MASK;
+	value |= ((uint32_t)phyreg << MII_REG_SHIFT) & MII_REG_MASK;
+
+	rte_write32(value, addr_reg);
+
+	timeout = STMMAC_MDIO_TIMEOUT_US;
+	while ((rte_read32(addr_reg) & MII_BUSY) && timeout > 0) {
+		rte_delay_us(1);
+		timeout--;
+	}
+	if (timeout == 0)
+		STMMAC_PMD_ERR("MDIO busy timeout after write");
+}
+
+/*
+ * RX burst. Single DMA channel (0), single-segment mbufs only.
+ * Descriptor ownership/status bits from dwmac4_descs.h; checksum
+ * flag mapping from RDES1 IPV4/IPV6_HEADER + IP_CSUM_ERROR only --
+ * GMAC4's RDES1 write-back layout has no L4-specific status bit, so
+ * RTE_MBUF_F_RX_L4_CKSUM_GOOD/BAD is intentionally not set here
+ * (left RTE_MBUF_F_RX_L4_CKSUM_UNKNOWN, value 0) rather than guessed.
+ *
+ * Shikra non-coherent memory fixes applied here (see commit message):
+ *   BUG-2: D-cache invalidation before descriptor read
+ *   BUG-3: full 36-bit RXTAIL doorbell (HI+LO)
+ *   BUG-4: preserve upper IOVA bits on refill (des[1])
+ */
+uint16_t
+stmmac_rx_pkt_burst(void *rx_queue, struct rte_mbuf **rx_pkts,
+		     uint16_t nb_pkts)
+{
+	struct stmmac_rx_queue *rxq = rx_queue;
+	uint16_t nb_rx = 0;
+	uint16_t tail = rxq->rx_tail;
+	uint16_t refilled = 0;
+	uint32_t ch_status;
+
+	while (nb_rx < nb_pkts) {
+		struct stmmac_desc *desc = &rxq->rx_ring[tail];
+		uint32_t des3;
+		struct rte_mbuf *rxm;
+		struct rte_mbuf *new_mb;
+		uint32_t pkt_len;
+
+		/*
+		 * BUG-2 FIX: Shikra non-coherent D-cache invalidation.
+		 *
+		 * Shikra (IQ9075) is a non-coherent platform: the DMA engine
+		 * writes descriptor write-back to physical DRAM but the CPU
+		 * ARM64 caches still hold a stale line showing OWN=1.
+		 *
+		 * rte_io_rmb() is a DSB-LD barrier -- it orders loads that
+		 * are *already visible*, but it does NOT invalidate D-cache
+		 * lines.  We must explicitly invalidate the cache line
+		 * covering this descriptor before reading des3.
+		 *
+		 * rte_clflush_cache_line() maps to:
+		 *   ARM64: DC CIVAC (Clean+Invalidate by VA to PoC)
+		 *   x86:   CLFLUSH
+		 *
+		 * Sequence (matching Linux dma_sync_single_for_cpu path):
+		 *   1. DC CIVAC on the descriptor cache line
+		 *   2. DSB-LD (rte_io_rmb) to ensure the invalidation
+		 *      completes before the subsequent load
+		 *   3. Volatile load (rte_read32) to bypass any compiler
+		 *      register caching of des3
+		 */
+		asm volatile("dc civac, %0" : : "r"(desc) : "memory"); /* arm64 clean+inval to PoC */
+		rte_io_rmb();
+		des3 = rte_read32(&desc->des[3]);
+
+		if (des3 & RDES3_OWN)
+			break;
+
+		if (des3 & RDES3_CONTEXT_DESCRIPTOR) {
+			/* Context descriptor: re-arm OWN and skip */
+			desc->des[3] = RDES3_OWN | RDES3_BUFFER1_VALID_ADDR |
+				       RDES3_INT_ON_COMPLETION_EN;
+			stmmac_dcache_clean(desc, sizeof(*desc));
+			tail = (tail + 1) % rxq->nb_desc;
+			continue;
+		}
+
+		if (des3 & RDES3_ERROR_SUMMARY) {
+			/* drop and recycle this descriptor's mbuf as-is */
+			desc->des[3] = RDES3_OWN | RDES3_BUFFER1_VALID_ADDR |
+				       RDES3_INT_ON_COMPLETION_EN;
+			stmmac_dcache_clean(desc, sizeof(*desc));
+			rxq->rx_errors++;
+			tail  = (tail + 1) % rxq->nb_desc;
+			refilled++;
+			continue;
+		}
+
+		new_mb = rte_pktmbuf_alloc(rxq->mb_pool);
+		if (unlikely(new_mb == NULL)) {
+			/* leave descriptor owned by SW; stop and retry later */
+			rxq->rx_nombuf++;
+			break;
+		}
+
+		rxm = rxq->sw_ring[tail];
+		pkt_len = des3 & RDES3_PACKET_SIZE_MASK;
+
+		/* drop stale CPU lines over the received payload */
+		stmmac_dcache_flush((uint8_t *)rxm->buf_addr + RTE_PKTMBUF_HEADROOM,
+				    pkt_len);
+
+		rxm->data_off = RTE_PKTMBUF_HEADROOM;
+		rxm->pkt_len = pkt_len;
+		rxm->data_len = pkt_len;
+		rxm->port = rxq->port_id;
+		rxm->nb_segs = 1;
+		rxm->next = NULL;
+		rxm->ol_flags = 0;
+
+		{
+			uint32_t des1 = desc->des[1];
+
+			if (des1 & (RDES1_IPV4_HEADER | RDES1_IPV6_HEADER)) {
+				if (des1 & RDES1_IP_CSUM_ERROR)
+					rxm->ol_flags |= RTE_MBUF_F_RX_IP_CKSUM_BAD;
+				else
+					rxm->ol_flags |= RTE_MBUF_F_RX_IP_CKSUM_GOOD;
+			}
+		}
+
+		rx_pkts[nb_rx++] = rxm;
+		rxq->rx_packets++;
+		rxq->rx_bytes += pkt_len;
+
+		/* Refill: install replacement mbuf into descriptor */
+		{
+		uint64_t new_iova = rte_pktmbuf_iova(new_mb);
+
+		rxq->sw_ring[tail] = new_mb;
+		/* drop any dirty lines over the new buffer before DMA writes it */
+		stmmac_dcache_flush(rte_pktmbuf_mtod(new_mb, void *),
+				    rte_pktmbuf_data_room_size(rxq->mb_pool) -
+				    RTE_PKTMBUF_HEADROOM);
+		/*
+		 * BUG-4 FIX: write the full 36-bit IOVA into des[0]/des[1].
+		 * Zeroing des[1] truncates the address to 32 bits -- all
+		 * Shikra mbufs live above 4 GiB (e.g. 0x1_018xxxxx).
+		 */
+		desc->des[0] = (uint32_t)new_iova;
+		desc->des[1] = (uint32_t)(new_iova >> 32);
+		desc->des[2] = 0;
+		rte_io_wmb();
+		desc->des[3] = RDES3_OWN | RDES3_BUFFER1_VALID_ADDR |
+			       RDES3_INT_ON_COMPLETION_EN; /* hand back to DMA */
+		stmmac_dcache_clean(desc, sizeof(*desc));
+		}
+
+		tail = (tail + 1) % rxq->nb_desc;
+		refilled++;
+	}
+
+	rxq->rx_tail = tail;
+
+	/*
+	 * RBU recovery: if the RX DMA suspended on an unavailable descriptor,
+	 * clear RBU (W1C) and re-ring the tail doorbell so it re-fetches.
+	 */
+	ch_status = rte_read32((uint8_t *)rxq->chan_base + DMA_CHAN_OFF_STATUS);
+	if (ch_status & DMA_CHAN_STATUS_RBU) {
+		rte_write32(DMA_CHAN_STATUS_RBU,
+			    (uint8_t *)rxq->chan_base + DMA_CHAN_OFF_STATUS);
+		refilled = refilled ? refilled : 1;
+	}
+
+	if (refilled > 0) {
+		/*
+		 * Tail = last descriptor handed back (one behind rx_tail).
+		 * Writing rx_tail itself makes RXTAIL == CURRXD after the DMA
+		 * catches up, which it treats as an empty ring (RBU).
+		 */
+		uint16_t last = (tail + rxq->nb_desc - 1) % rxq->nb_desc;
+		uint64_t tail_iova = rxq->rx_ring_iova +
+			(uint64_t)last * sizeof(struct stmmac_desc);
+		/*
+		 * BUG-3 FIX: write the full 36-bit tail IOVA to both
+		 * RXTAIL_HI (chan_base+0x24) and RXTAIL_LO (chan_base+0x28).
+		 *
+		 * Shikra ring IOVAs live above 4 GiB.  The previous code
+		 * only wrote the low 32 bits.  After a ring wrap the
+		 * doorbell equals RXBASE, so the DMA thinks no new
+		 * descriptors have been added and stalls permanently.
+		 *
+		 * Per DWC EQoS RM (and dwmac4_dma.h:122) the HI register
+		 * must be written before the LO register.
+		 */
+		rte_write32((uint32_t)(tail_iova >> 32),
+			    (uint8_t *)rxq->chan_base +
+			    DMA_CHAN_OFF_RX_END_ADDR_HI);
+		rte_io_wmb(); /* ensure HI lands before LO */
+		rte_write32((uint32_t)tail_iova,
+			    (uint8_t *)rxq->chan_base +
+			    DMA_CHAN_OFF_RX_END_ADDR);
+	}
+	if (nb_rx > 0)
+		fprintf(stderr, "--MD-- stmmac_rx_pkt_burst nb_rx=%u tail=%u\n",
+			nb_rx, tail);
+	return nb_rx;
+}
+
+/*
+ * TX burst. Single DMA channel (0), single-segment mbufs only
+ * (Phase 1 -- no TSO / multi-descriptor scatter chaining).
+ * Opportunistic reclaim: before using a ring slot, poll TDES3_OWN on
+ * it to free the previous mbuf, since there is no IRQ-driven TX
+ * completion callback available at the platform bus layer.
+ *
+ * Shikra non-coherent memory (same as RX):
+ *   - invalidate the slot's descriptor before reading OWN (DMA write-back)
+ *   - clean the payload before the DMA reads it
+ *   - clean the descriptor after setting OWN, before the tail doorbell
+ * TXTAIL = next free slot (one past the last queued), as in Linux
+ * stmmac_main.c; TX DMA sends CURTXD..TXTAIL-1, then idles with TBU.
+ *
+ * --MD-- debug prints: "---MD--- TX[n] ..." per stage, only when nb_tx > 0
+ * or on a stop condition, so idle polling does not flood the console.
+ */
+uint16_t
+stmmac_tx_pkt_burst(void *tx_queue, struct rte_mbuf **tx_pkts,
+		     uint16_t nb_pkts)
+{
+	struct stmmac_tx_queue *txq = tx_queue;
+	uint16_t nb_tx = 0;
+	uint16_t tail = txq->tx_tail;
+	uint16_t sent = 0;
+	static uint64_t md_calls;
+
+	md_calls++;
+	if (nb_pkts > 0 && md_calls <= 8)
+		fprintf(stderr, "---MD--- TX[1] tx pkt burst entered call=%" PRIu64 " nb_pkts=%u tail=%u\n",
+			md_calls, nb_pkts, tail);
+
+	while (nb_tx < nb_pkts) {
+		struct stmmac_desc *desc = &txq->tx_ring[tail];
+		struct rte_mbuf *txm = tx_pkts[nb_tx];
+		uint32_t tdes3;
+		uint64_t ol_flags;
+		uint64_t iova;
+
+		if (unlikely(txm->nb_segs != 1)) {
+			STMMAC_PMD_ERR("multi-segment mbuf not supported (Phase 1)");
+			fprintf(stderr, "---MD--- TX[2] STOP: multi-seg mbuf nb_segs=%u at tail=%u\n",
+				txm->nb_segs, tail);
+			break;
+		}
+
+		/*
+		 * Cache-line sharing guard (non-coherent ring, 4 x 16B descs per
+		 * 64B line). dc cvac writes back the WHOLE line, so writing slot N
+		 * while the DMA still owns a neighbour in the same line would
+		 * overwrite the DMA's OWN=0 write-back of that neighbour with our
+		 * stale OWN=1 copy -> permanent "ring full" deadlock (seen at slot
+		 * 207). Only touch a line once the DMA is done with ALL its slots.
+		 * Needed at the first slot of every line, and for the first slot
+		 * of this burst (earlier slots of its line went out last burst).
+		 * Slots written later in the same line in this burst are safe:
+		 * the DMA cannot see them until the doorbell below.
+		 */
+		if ((tail % STMMAC_DESCS_PER_LINE) == 0 || nb_tx == 0) {
+			uint16_t first = tail - (tail % STMMAC_DESCS_PER_LINE);
+			uint16_t k;
+
+			stmmac_dcache_flush(&txq->tx_ring[first],
+					    STMMAC_DESCS_PER_LINE * sizeof(*desc));
+			for (k = 0; k < STMMAC_DESCS_PER_LINE; k++) {
+				tdes3 = rte_read32(&txq->tx_ring[first + k].des[3]);
+				if (tdes3 & TDES3_OWN)
+					break;
+			}
+			if (k < STMMAC_DESCS_PER_LINE) {
+				txq->tx_ring_full++;
+				if (txq->tx_ring_full <= 8 || (txq->tx_ring_full % 100000) == 0)
+					fprintf(stderr, "---MD--- TX[2] STOP: line %u busy, slot %u still OWN=1 des3=0x%08x (want slot %u) count=%" PRIu64 "\n",
+						first / STMMAC_DESCS_PER_LINE, first + k, tdes3,
+						tail, txq->tx_ring_full);
+				break;
+			}
+		}
+		tdes3 = rte_read32(&desc->des[3]);
+		if (tdes3 & TDES3_OWN) {
+			txq->tx_ring_full++;
+			if (txq->tx_ring_full <= 8 || (txq->tx_ring_full % 100000) == 0)
+				fprintf(stderr, "---MD--- TX[2] STOP: ring full, slot %u still OWN=1 des3=0x%08x (DMA not done) count=%" PRIu64 "\n",
+					tail, tdes3, txq->tx_ring_full);
+			break;
+		}
+
+		if (txq->sw_ring[tail] != NULL) {
+			/* previous frame in this slot completed: check its status */
+			if (tdes3 & TDES3_ERROR_SUMMARY) {
+				txq->tx_errors++;
+				if (txq->tx_errors <= 8)
+					fprintf(stderr, "---MD--- TX[3] reclaim slot %u: ERROR des3=0x%08x\n",
+						tail, tdes3);
+			}
+			rte_pktmbuf_free(txq->sw_ring[tail]);
+			txq->sw_ring[tail] = NULL;
+		}
+
+		/* CPU-written payload must reach DDR before the DMA reads it */
+		stmmac_dcache_clean(rte_pktmbuf_mtod(txm, void *),
+				    rte_pktmbuf_data_len(txm));
+
+		iova = rte_pktmbuf_iova(txm);
+		desc->des[0] = (uint32_t)iova;
+		desc->des[1] = (uint32_t)(iova >> 32);	/* mbufs live above 4 GiB */
+		desc->des[2] = rte_pktmbuf_data_len(txm) & TDES2_BUFFER1_SIZE_MASK;
+
+		tdes3 = rte_pktmbuf_pkt_len(txm) & TDES3_PACKET_SIZE_MASK;
+		tdes3 |= TDES3_FIRST_DESCRIPTOR | TDES3_LAST_DESCRIPTOR;
+
+		ol_flags = txm->ol_flags;
+		if (ol_flags & (RTE_MBUF_F_TX_IP_CKSUM | RTE_MBUF_F_TX_L4_MASK))
+			tdes3 |= (TX_CIC_FULL << TDES3_CHECKSUM_INSERTION_SHIFT);
+
+		txq->sw_ring[tail] = txm;
+
+		rte_io_wmb();
+		tdes3 |= TDES3_OWN;
+		desc->des[3] = tdes3;
+		/* hand descriptor to DMA: push it to DDR */
+		stmmac_dcache_clean(desc, sizeof(*desc));
+
+		if (txq->tx_packets < 4)
+			fprintf(stderr, "---MD--- TX[4] queued slot %u iova=0x%" PRIx64 " len=%u des=%08x %08x %08x %08x\n",
+				tail, iova, rte_pktmbuf_pkt_len(txm),
+				desc->des[0], desc->des[1], desc->des[2], desc->des[3]);
+
+		txq->tx_packets++;
+		txq->tx_bytes += rte_pktmbuf_pkt_len(txm);
+
+		tail = (tail + 1) % txq->nb_desc;
+		nb_tx++;
+		sent++;
+	}
+
+	txq->tx_tail = tail;
+
+	if (sent > 0) {
+		uint64_t tail_iova = txq->tx_ring_iova +
+			(uint64_t)tail * sizeof(struct stmmac_desc);
+		rte_write32((uint32_t)tail_iova,
+			    (uint8_t *)txq->chan_base +
+			    DMA_CHAN_OFF_TX_END_ADDR);
+		/* first few doorbells, then one every 1000 to avoid a txonly flood */
+		if (txq->tx_packets <= 16 || (txq->tx_packets % 1000) < nb_tx)
+			fprintf(stderr, "---MD--- TX[5] doorbell nb_tx=%u tail=%u TXTAIL=0x%08x | CURTXD=0x%08x CH0_STATUS=0x%08x total=%" PRIu64 "\n",
+			nb_tx, tail, (uint32_t)tail_iova,
+			rte_read32((uint8_t *)txq->chan_base + 0x44),
+			rte_read32((uint8_t *)txq->chan_base + DMA_CHAN_OFF_STATUS),
+			txq->tx_packets);
+	}
+
+	return nb_tx;
+}
-- 
